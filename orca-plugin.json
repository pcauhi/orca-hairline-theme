{
  "manifestVersion": 2,
  "id": "hairline-theme",
  "name": "Hairline",
  "version": "1.1.0",
  "description": "A quiet near-black and gray theme with hairline borders, inspired by the look of modern AI code editors. Light and dark app, code and terminal colors.",
  "license": "MIT",
  "repository": "https://github.com/pcauhi/orca-hairline-theme",
  "engines": {
    "orca": ">=1.4.246"
  },
  "execution": "data",
  "contributes": {
    "themes": [
      {
        "id": "hairline-dark",
        "title": "Hairline Dark",
        "path": "themes/hairline-dark.json"
      },
      {
        "id": "hairline-light",
        "title": "Hairline Light",
        "path": "themes/hairline-light.json"
      }
    ],
    "terminalThemes": [
      {
        "id": "hairline-dark",
        "title": "Hairline Dark",
        "path": "terminal/hairline-dark.json"
      },
      {
        "id": "hairline-light",
        "title": "Hairline Light",
        "path": "terminal/hairline-light.json"
      }
    ]
  }
}

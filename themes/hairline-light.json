{
  "schemaVersion": 1,
  "base": "light",
  "tokens": {
    "--background": "#f7f7f7",
    "--editor-surface": "#ffffff",
    "--foreground": "#1f1f1f",
    "--card": "#f7f7f7",
    "--card-foreground": "#1f1f1f",
    "--popover": "#ffffff",
    "--popover-foreground": "#1f1f1f",
    "--primary": "#1f1f1f",
    "--primary-foreground": "#ffffff",
    "--secondary": "#ececec",
    "--secondary-foreground": "#1f1f1f",
    "--muted": "#f0f0f0",
    "--muted-foreground": "#666666",
    "--accent": "#ebebeb",
    "--accent-foreground": "#111111",
    "--border": "#e6e6e6",
    "--input": "#dcdcdc",
    "--ring": "#a3a3a3",
    "--chart-1": "#1f1f1f",
    "--chart-2": "#0a6bc4",
    "--chart-3": "#0f7d78",
    "--chart-4": "#b35a00",
    "--chart-5": "#6a4fd1",

    "--sidebar": "#f7f7f7",
    "--sidebar-foreground": "#2a2a2a",
    "--sidebar-primary": "#1f1f1f",
    "--sidebar-primary-foreground": "#ffffff",
    "--sidebar-accent": "#ececec",
    "--sidebar-accent-foreground": "#111111",
    "--sidebar-border": "#e8e8e8",
    "--sidebar-ring": "#a3a3a3",

    "--worktree-sidebar": "#f2f2f2",
    "--worktree-sidebar-foreground": "#2a2a2a",
    "--worktree-sidebar-accent": "#e9e9e9",
    "--worktree-sidebar-accent-foreground": "#111111",
    "--worktree-sidebar-border": "#e4e4e4",
    "--worktree-sidebar-ring": "#a3a3a3",
    "--worktree-sidebar-active": "#e4e4e4",
    "--worktree-sidebar-active-border": "#d6d6d6",
    "--host-badge": "#e8e8e8",
    "--host-badge-foreground": "#575757",

    "--tab-bar": "#f7f7f7",
    "--tab-active": "#ffffff",
    "--tab-active-foreground": "#1f1f1f",
    "--tab-active-indicator": "#b5b5b5",
    "--tab-inactive": "#f7f7f7",
    "--tab-inactive-foreground": "#666666",
    "--split-divider": "#e6e6e6",
    "--split-divider-hover": "#cccccc",

    "--chat-user-message": "#efefef",
    "--chat-bold-foreground": "#111111",
    "--chat-muted-foreground": "#636363",
    "--chat-inline-code": "#ececec",
    "--chat-inline-code-foreground": "#1f1f1f",
    "--chat-code-block": "#f4f4f4",
    "--chat-selection": "#cfe2f7",
    "--chat-selection-foreground": "#111111",
    "--text-link": "#0a6bc4",

    "--diff-added": "#1a7f4b",
    "--diff-removed": "#c9372c",

    "--git-decoration-added": "#2f8a4f",
    "--git-decoration-modified": "#946200",
    "--git-decoration-deleted": "#c9372c",
    "--git-decoration-renamed": "#0f7d78",
    "--git-decoration-untracked": "#2f8a4f",
    "--git-decoration-copied": "#0a6bc4",
    "--git-decoration-ignored": "#8a8a8a"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#8a8a8a", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "#0f7d78" } },
    { "scope": ["keyword.operator", "punctuation.accessor"], "settings": { "foreground": "#5c5c5c" } },
    { "scope": ["string", "string.template", "punctuation.definition.string"], "settings": { "foreground": "#b0389f" } },
    { "scope": ["string.regexp", "constant.character.escape"], "settings": { "foreground": "#8a3fc0" } },
    { "scope": ["constant.numeric", "constant.language", "constant.language.boolean"], "settings": { "foreground": "#946200" } },
    { "scope": ["constant", "variable.other.constant", "variable.other.enummember"], "settings": { "foreground": "#946200" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"], "settings": { "foreground": "#b35a00" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class", "storage.type.class"], "settings": { "foreground": "#0a6bc4" } },
    { "scope": ["variable", "meta.definition.variable"], "settings": { "foreground": "#1f1f1f" } },
    { "scope": ["variable.parameter", "meta.parameter"], "settings": { "foreground": "#1f1f1f", "fontStyle": "italic" } },
    { "scope": ["variable.language", "variable.language.this"], "settings": { "foreground": "#a8455a", "fontStyle": "italic" } },
    { "scope": ["variable.other.property", "variable.other.object.property", "support.variable.property", "meta.object-literal.key"], "settings": { "foreground": "#6a4fd1" } },
    { "scope": ["entity.name.tag", "meta.tag.sgml"], "settings": { "foreground": "#0a6bc4" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#6a4fd1" } },
    { "scope": ["punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator"], "settings": { "foreground": "#6b6b6b" } },
    { "scope": ["entity.name.namespace", "entity.name.module", "entity.name.import"], "settings": { "foreground": "#333333" } },
    { "scope": ["support.type.property-name.json", "support.type.property-name"], "settings": { "foreground": "#0f7d78" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#111111", "fontStyle": "bold" } },
    { "scope": "markup.bold", "settings": { "foreground": "#111111", "fontStyle": "bold" } },
    { "scope": "markup.italic", "settings": { "foreground": "#1f1f1f", "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#b0389f" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#0a6bc4", "fontStyle": "underline" } },
    { "scope": "markup.quote", "settings": { "foreground": "#666666", "fontStyle": "italic" } },
    { "scope": ["markup.inserted", "meta.diff.header.to-file"], "settings": { "foreground": "#1a7f4b" } },
    { "scope": ["markup.deleted", "meta.diff.header.from-file"], "settings": { "foreground": "#c9372c" } },
    { "scope": "markup.changed", "settings": { "foreground": "#946200" } },
    { "scope": "invalid", "settings": { "foreground": "#d1242f", "fontStyle": "underline" } }
  ]
}

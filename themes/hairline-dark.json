{
  "schemaVersion": 1,
  "base": "dark",
  "tokens": {
    "--background": "#141414",
    "--editor-surface": "#181818",
    "--foreground": "#e4e4e4",
    "--card": "#141414",
    "--card-foreground": "#e4e4e4",
    "--popover": "#1c1c1c",
    "--popover-foreground": "#e4e4e4",
    "--primary": "#e4e4e4",
    "--primary-foreground": "#141414",
    "--secondary": "#222222",
    "--secondary-foreground": "#e4e4e4",
    "--muted": "#1c1c1c",
    "--muted-foreground": "#8c8c8c",
    "--accent": "#242424",
    "--accent-foreground": "#f2f2f2",
    "--border": "#242424",
    "--input": "#2c2c2c",
    "--ring": "#5e5e5e",
    "--chart-1": "#e4e4e4",
    "--chart-2": "#87c3ff",
    "--chart-3": "#82d2ce",
    "--chart-4": "#efb080",
    "--chart-5": "#aa9bf5",

    "--sidebar": "#141414",
    "--sidebar-foreground": "#d6d6d6",
    "--sidebar-primary": "#e4e4e4",
    "--sidebar-primary-foreground": "#141414",
    "--sidebar-accent": "#202020",
    "--sidebar-accent-foreground": "#f2f2f2",
    "--sidebar-border": "#222222",
    "--sidebar-ring": "#5e5e5e",

    "--worktree-sidebar": "#111111",
    "--worktree-sidebar-foreground": "#d6d6d6",
    "--worktree-sidebar-accent": "#1c1c1c",
    "--worktree-sidebar-accent-foreground": "#f2f2f2",
    "--worktree-sidebar-border": "#202020",
    "--worktree-sidebar-ring": "#5e5e5e",
    "--worktree-sidebar-active": "#222222",
    "--worktree-sidebar-active-border": "#2e2e2e",
    "--host-badge": "#202020",
    "--host-badge-foreground": "#9a9a9a",

    "--tab-bar": "#141414",
    "--tab-active": "#181818",
    "--tab-active-foreground": "#e4e4e4",
    "--tab-active-indicator": "#4a4a4a",
    "--tab-inactive": "#141414",
    "--tab-inactive-foreground": "#8c8c8c",
    "--split-divider": "#222222",
    "--split-divider-hover": "#3a3a3a",

    "--chat-user-message": "#1f1f1f",
    "--chat-bold-foreground": "#f2f2f2",
    "--chat-muted-foreground": "#8c8c8c",
    "--chat-inline-code": "#232323",
    "--chat-inline-code-foreground": "#e4e4e4",
    "--chat-code-block": "#1a1a1a",
    "--chat-selection": "#2f3b4a",
    "--chat-selection-foreground": "#f2f2f2",
    "--text-link": "#87c3ff",

    "--diff-added": "#3fb27f",
    "--diff-removed": "#e5534b",

    "--git-decoration-added": "#6fbf8a",
    "--git-decoration-modified": "#e2c08d",
    "--git-decoration-deleted": "#e06c75",
    "--git-decoration-renamed": "#82d2ce",
    "--git-decoration-untracked": "#6fbf8a",
    "--git-decoration-copied": "#87c3ff",
    "--git-decoration-ignored": "#6a6a6a"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#6e6e6e", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "#82d2ce" } },
    { "scope": ["keyword.operator", "punctuation.accessor"], "settings": { "foreground": "#a8a8a8" } },
    { "scope": ["string", "string.template", "punctuation.definition.string"], "settings": { "foreground": "#e394dc" } },
    { "scope": ["string.regexp", "constant.character.escape"], "settings": { "foreground": "#d6a9f0" } },
    { "scope": ["constant.numeric", "constant.language", "constant.language.boolean"], "settings": { "foreground": "#ebc88d" } },
    { "scope": ["constant", "variable.other.constant", "variable.other.enummember"], "settings": { "foreground": "#ebc88d" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"], "settings": { "foreground": "#efb080" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class", "storage.type.class"], "settings": { "foreground": "#87c3ff" } },
    { "scope": ["variable", "meta.definition.variable"], "settings": { "foreground": "#d6d6dd" } },
    { "scope": ["variable.parameter", "meta.parameter"], "settings": { "foreground": "#d6d6dd", "fontStyle": "italic" } },
    { "scope": ["variable.language", "variable.language.this"], "settings": { "foreground": "#c1808a", "fontStyle": "italic" } },
    { "scope": ["variable.other.property", "variable.other.object.property", "support.variable.property", "meta.object-literal.key"], "settings": { "foreground": "#aa9bf5" } },
    { "scope": ["entity.name.tag", "meta.tag.sgml"], "settings": { "foreground": "#87c3ff" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#aa9bf5" } },
    { "scope": ["punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator"], "settings": { "foreground": "#9a9a9a" } },
    { "scope": ["entity.name.namespace", "entity.name.module", "entity.name.import"], "settings": { "foreground": "#d1d1d1" } },
    { "scope": ["support.type.property-name.json", "support.type.property-name"], "settings": { "foreground": "#82d2ce" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#f2f2f2", "fontStyle": "bold" } },
    { "scope": "markup.bold", "settings": { "foreground": "#f2f2f2", "fontStyle": "bold" } },
    { "scope": "markup.italic", "settings": { "foreground": "#e4e4e4", "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#e394dc" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#87c3ff", "fontStyle": "underline" } },
    { "scope": "markup.quote", "settings": { "foreground": "#8c8c8c", "fontStyle": "italic" } },
    { "scope": ["markup.inserted", "meta.diff.header.to-file"], "settings": { "foreground": "#3fb27f" } },
    { "scope": ["markup.deleted", "meta.diff.header.from-file"], "settings": { "foreground": "#e5534b" } },
    { "scope": "markup.changed", "settings": { "foreground": "#e2c08d" } },
    { "scope": "invalid", "settings": { "foreground": "#f14c4c", "fontStyle": "underline" } }
  ]
}
